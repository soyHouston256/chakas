# Sitio CHANKAS y proxy API. Plantilla procesada por envsubst (FRAME_ANCESTORS y API_UPSTREAM,
# ver NGINX_ENVSUBST_FILTER en el Dockerfile), así que las variables de nginx quedan intactas.
server {
    listen 8080 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;      # redirecciones relativas: no filtra el puerto interno 8080
    autoindex off;
    etag on;

    # Cabeceras también para respuestas generadas a nivel de servidor (p. ej. el 405). Cada
    # location las vuelve a incluir porque su propio add_header anula la herencia.
    include /tmp/conf.d/security-headers.inc;

    # Resolución diferida: el sitio también arranca sin la API (modo local).
    resolver 127.0.0.11 valid=30s ipv6=off;
    location /api/ {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass http://$api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        include /tmp/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }

    error_page 404 /404.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        include /tmp/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
        return 200 "ok\n";
    }

    # El HTML siempre se revalida (ETag/If-None-Match → 304 si no cambió).
    location = / {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        include /tmp/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }

    location = /index.html {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        include /tmp/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }

    # JS/CSS con hash de contenido en el nombre (scripts/build-dist.cjs): inmutables.
    location ~* "\.[0-9a-f]{12}\.(js|css)$" {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        include /tmp/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /404.html {
        internal;
        include /tmp/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }

    # Manifiesto de la app web (Añadir a pantalla de inicio): tipo MIME explícito.
    location = /manifest.webmanifest {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        types { }
        default_type application/manifest+json;
        include /tmp/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }

    # El favicon real es assets/favicon.svg (<link rel="icon">); /favicon.ico responde vacío
    # para evitar 404 ruidosos en los logs.
    location = /favicon.ico {
        access_log off;
        log_not_found off;
        include /tmp/conf.d/security-headers.inc;
        return 204;
    }

    location / {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        include /tmp/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
}
